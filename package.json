{
  "name": "kharcha-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:users": "wrangler d1 execute DB --remote --command \"SELECT id, name, email FROM users;\"",
    "db:clear-users": "wrangler d1 execute DB --remote --command \"DELETE FROM refresh_tokens; DELETE FROM users;\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.2",
    "@noble/hashes": "^1.7.1",
    "hono": "^4.7.4",
    "jose": "^6.0.8",
    "nanoid": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.100.0"
  }
}
